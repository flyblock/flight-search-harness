{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/round-trip-intent.schema.json",
  "title": "AI-structured regional round-trip intent v0.4.0",
  "description": "City and region anchors are preserved. The AI may supply seed gateways, but the materializer never chooses an airport from a city name.",
  "type": "object",
  "required": ["intent_id", "trip_scope", "trip_mode", "currency", "traveler_count", "baggage_policy", "overnight_allowed", "self_transfer_policy", "origin", "destination"],
  "properties": {
    "intent_version": {"const": "0.4.0"},
    "intent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "trip_scope": {"const": "round_trip"},
    "trip_mode": {"const": "fixed_destination"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "traveler_count": {"type": "integer", "minimum": 1},
    "baggage_policy": {"$ref": "#/$defs/baggage_policy"},
    "origin": {"$ref": "#/$defs/region_side"},
    "destination": {"$ref": "#/$defs/region_side"},
    "travel_window": {"$ref": "#/$defs/date_window"},
    "outbound_departure_window": {"$ref": "#/$defs/date_window"},
    "return_departure_window": {"$ref": "#/$defs/date_window"},
    "minimum_stay_nights": {"type": "integer", "minimum": 0, "description": "Minimum destination stay measured as the difference between the local calendar date of arrival at the destination anchor and the local calendar date of the first return departure from that anchor."},
    "maximum_stay_nights": {"type": "integer", "minimum": 0, "description": "Maximum destination stay measured as the difference between the local calendar date of arrival at the destination anchor and the local calendar date of the first return departure from that anchor."},
    "allowed_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/mode"}},
    "mode_transition_buffers_minutes": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "max_portfolio_offers": {"type": "integer", "minimum": 1, "default": 8},
    "max_solver_offers": {"type": "integer", "minimum": 1, "default": 24},
    "transport_entitlements": {"type": "array", "items": {"type": "object"}},
    "accommodation_cost_policy": {"enum": ["include_required", "exclude_from_optimization"], "default": "include_required"},
    "date_flexibility": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["exact_dates", "bounded_window", "fully_flexible", "independent"]},
        "outbound_mode": {"enum": ["exact_dates", "bounded_window", "fully_flexible"]},
        "return_mode": {"enum": ["exact_dates", "bounded_window", "fully_flexible"]},
        "outbound_exact_departure_dates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "date"}},
        "return_exact_departure_dates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "date"}}
      },
      "additionalProperties": false
    },
    "budget": {"$ref": "#/$defs/money"},
    "overnight_allowed": {"type": "boolean"},
    "self_transfer_policy": {"enum": ["allow", "avoid", "never"]},
    "maximum_total_duration_minutes": {"type": "integer", "minimum": 1},
    "airport_transit_unknown_policy": {"enum": ["allow_with_warning", "reject"], "default": "allow_with_warning"},
    "fx_snapshot": {"type": "object"}
  },
  "oneOf": [
    {"required": ["travel_window"]},
    {"required": ["outbound_departure_window", "return_departure_window"]}
  ],
  "additionalProperties": false,
  "$defs": {
    "date_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}},
      "additionalProperties": false
    },
    "region_side": {
      "type": "object",
      "required": ["region_id", "label", "country_codes", "anchor_nodes"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "country_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "policy": {"enum": ["exact", "city_region", "extended_region"], "default": "city_region"},
        "endpoint_policy": {"enum": ["anchor_required", "any_admitted_gateway"], "default": "anchor_required", "description": "Use any_admitted_gateway only when the user named a region rather than a concrete city/station endpoint."},
        "anchor_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "seed_gateway_nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "max_access_time_minutes": {"type": "integer", "minimum": 0},
        "max_egress_time_minutes": {"type": "integer", "minimum": 0},
        "max_ground_cost": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
        "allowed_ground_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ground_mode"}},
        "expansion": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["node_id", "node_type", "location", "country_or_region", "timezone"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "node_type": {"enum": ["airport", "railway_station", "bus_terminal", "ferry_terminal", "city_destination"]},
        "location": {"type": "string", "minLength": 1},
        "country_or_region": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "timezone": {"type": "string", "minLength": 1},
        "utc_offset": {"type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$"}
      },
      "additionalProperties": true
    },
    "money": {"type": "object", "required": ["amount", "currency"], "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}, "additionalProperties": false},
    "baggage_policy": {"type": "object", "required": ["required_items"], "properties": {"required_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "paid_baggage_allowed": {"type": "boolean", "default": false}}, "additionalProperties": false},
    "mode": {"enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]},
    "ground_mode": {"enum": ["rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]}
  }
}
