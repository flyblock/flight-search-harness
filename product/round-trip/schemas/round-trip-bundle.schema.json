{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/round-trip-bundle.schema.json",
  "title": "Verified atomic-offer round-trip bundle v0.4.0",
  "type": "object",
  "required": ["schema_version", "base_currency", "intent", "nodes", "movements", "offers"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "intent": {"type": "object"},
    "nodes": {"type": "array", "minItems": 2, "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}},
    "transport_entitlements": {"type": "array", "items": {"type": "object"}},
    "fx_snapshot": {"type": "object"},
    "evaluation_at": {"type": "string", "format": "date-time"},
    "movements": {"type": "array", "items": {"$ref": "#/$defs/movement"}},
    "offers": {"type": "array", "items": {"$ref": "#/$defs/offer"}}
  },
  "additionalProperties": false,
  "$defs": {
    "window": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "money": {"type": "object", "required": ["amount", "currency"], "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}, "additionalProperties": false},
    "movement": {
      "type": "object",
      "required": ["movement_id", "from_node", "to_node", "departure", "arrival", "mode", "operator", "service_id"],
      "properties": {
        "movement_id": {"type": "string"},
        "from_node": {"type": "string"},
        "to_node": {"type": "string"},
        "departure": {"type": "string", "format": "date-time"},
        "arrival": {"type": "string", "format": "date-time"},
        "mode": {"enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]},
        "operator": {"type": "string"},
        "service_id": {"type": "string"}
        ,"flight_identity": {"type": "object"}
        ,"transfer_from_previous": {"$ref": "#/$defs/transfer"}
      },
      "additionalProperties": true
    },
    "transfer": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "unknown", "infeasible"]},
        "connection_protection": {"enum": ["carrier_protected", "self_transfer", "unknown"]},
        "minimum_connection_minutes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "offer": {
      "type": "object",
      "required": ["offer_id", "provider_offer_id", "source_id", "pricing_scope", "journey_scope", "atomic", "movement_ids", "price", "mandatory_baggage_cost", "included_baggage", "provider", "seller", "url", "observed_at", "evidence_status"],
      "properties": {
        "offer_id": {"type": "string"},
        "provider_offer_id": {"type": "string"},
        "source_id": {"type": "string"},
        "pricing_scope": {"const": "atomic_offer"},
        "journey_scope": {"enum": ["joint_round_trip", "one_way", "atomic_itinerary", "surface"]},
        "direction": {"enum": ["outbound", "return"]},
        "atomic": {"const": true},
        "movement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "price": {"$ref": "#/$defs/money"},
        "mandatory_baggage_cost": {"$ref": "#/$defs/money"},
        "required_accommodation_cost": {"$ref": "#/$defs/money"},
        "included_baggage": {"type": "array", "items": {"type": "string"}},
        "provider": {"type": "string"},
        "seller": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "evidence_status": {"const": "verified_observed"},
        "entitlement_tags": {"type": "array", "items": {"type": "string"}},
        "research_task_id": {"type": "string"},
        "hypothesis_id": {"type": "string"},
        "itinerary_id": {"type": "string"},
        "offer_snapshot_id": {"type": "string"},
        "coverage_start_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "coverage_end_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "surface_role": {"type": "string"},
        "pool_constraints": {"type": "object"}
        ,"ticket_context": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"journey_scope": {"const": "one_way"}}}, "then": {"required": ["direction", "coverage_start_nodes", "coverage_end_nodes"]}},
        {"if": {"properties": {"journey_scope": {"const": "surface"}}}, "then": {"required": ["surface_role", "pool_constraints"]}}
      ],
      "additionalProperties": true
    }
  }
}
