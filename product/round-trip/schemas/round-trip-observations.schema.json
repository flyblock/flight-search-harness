{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/round-trip-observations.schema.json",
  "title": "AI browser observations v0.4.0",
  "type": "object",
  "required": ["observation_version", "bundle_id", "task_id", "observations"],
  "properties": {
    "observation_version": {"const": "0.4.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "coverage_complete": {"type": "boolean", "readOnly": true},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {"type": "object", "required": ["observation_id", "evidence_status"], "properties": {"observation_id": {"type": "string"}, "source_id": {"type": "string"}, "evidence_status": {"enum": ["ai_proposed", "verified_observed", "research_observed", "no_result", "rejected"]}, "provider": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "observed_at": {"type": "string", "format": "date-time"}, "price_selection_method": {"enum": ["lowest_price_view", "price_ascending", "all_visible_compared"]}, "proposal_type": {"const": "region_scope"}, "proposed_by": {"const": "ai"}, "proposed_at": {"type": "string", "format": "date-time"}}},
    "money": {"type": "object", "required": ["amount", "currency"], "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Za-z]{3}$"}}, "additionalProperties": false},
    "provider_scope": {
      "type": "object",
      "required": ["coverage_semantics", "origin_gateway_node_ids", "destination_gateway_node_ids", "outbound_departure_window", "return_departure_window", "minimum_stay_nights", "maximum_stay_nights"],
      "properties": {
        "coverage_semantics": {"const": "provider_ranked_window"},
        "origin_gateway_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "destination_gateway_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outbound_departure_window": {"$ref": "#/$defs/date_window"},
        "return_departure_window": {"$ref": "#/$defs/date_window"},
        "minimum_stay_nights": {"type": ["integer", "null"], "minimum": 0},
        "maximum_stay_nights": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "date_window": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}, "additionalProperties": false},
    "itinerary_dates": {
      "type": "object",
      "required": ["outbound_departure_local_date", "outbound_destination_arrival_local_date", "return_departure_local_date"],
      "properties": {
        "outbound_departure_local_date": {"type": "string", "format": "date"},
        "outbound_destination_arrival_local_date": {"type": "string", "format": "date"},
        "return_departure_local_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "seller_listing": {
      "type": "object",
      "required": ["scope", "terminal_witness"],
      "properties": {
        "scope": {"const": "exact_itinerary_booking_options"},
        "terminal_witness": {
          "type": "object",
          "required": ["kind", "observed_offer_count", "next_page_available"],
          "properties": {
            "kind": {"enum": ["provider_declared_count", "end_of_list", "pagination_exhausted"]},
            "observed_offer_count": {"type": "integer", "minimum": 1},
            "provider_reported_offer_count": {"type": "integer", "minimum": 1},
            "next_page_available": {"const": false},
            "source_artifact_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gateway_signal_input": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "signal_kind": {"type": "string", "minLength": 1},
        "dated_fare_amount": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/money"}]},
        "lowest_displayed_total": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/money"}]},
        "date_coverage": {"enum": ["sampled_date_pair", "exact_dates", "bounded_window"]},
        "complete_cost_lower_bound": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/money"}]},
        "access_cost": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/money"}]},
        "opposite_gateway_node_id": {"type": "string", "minLength": 1},
        "origin_gateway_node_id": {"type": "string", "minLength": 1},
        "destination_gateway_node_id": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["kind"]}, {"required": ["signal_kind"]}],
      "allOf": [{"if": {"required": ["date_coverage"]}, "then": {"anyOf": [{"required": ["dated_fare_amount"]}, {"required": ["lowest_displayed_total"]}]}}],
      "additionalProperties": true
    },
    "gateway_candidate_input": {
      "type": "object",
      "required": ["candidate_id", "side", "node", "signal"],
      "properties": {"candidate_id": {"type": "string", "minLength": 1}, "side": {"enum": ["origin", "destination"]}, "node": {"type": "object"}, "signal": {"$ref": "#/$defs/gateway_signal_input"}},
      "allOf": [
        {"if": {"properties": {"side": {"const": "origin"}, "signal": {"anyOf": [{"required": ["dated_fare_amount"]}, {"required": ["lowest_displayed_total"]}, {"required": ["complete_cost_lower_bound"]}]}}}, "then": {"properties": {"signal": {"anyOf": [{"required": ["opposite_gateway_node_id"]}, {"required": ["destination_gateway_node_id"]}]}}}},
        {"if": {"properties": {"side": {"const": "destination"}, "signal": {"anyOf": [{"required": ["dated_fare_amount"]}, {"required": ["lowest_displayed_total"]}, {"required": ["complete_cost_lower_bound"]}]}}}, "then": {"properties": {"signal": {"anyOf": [{"required": ["opposite_gateway_node_id"]}, {"required": ["origin_gateway_node_id"]}]}}}}
      ],
      "additionalProperties": true
    },
    "observation": {
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {
          "type": "object",
          "properties": {
            "reason": {"type": "string"},
            "date_coverage": {"enum": ["sampled_date_pair", "exact_dates", "bounded_window"]},
            "nodes": {"type": "array", "items": {"type": "object"}},
            "movements": {"type": "array", "items": {"type": "object"}},
            "offers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "seller_listing": {"$ref": "#/$defs/seller_listing"},
            "gateway_candidates": {"type": "array", "items": {"$ref": "#/$defs/gateway_candidate_input"}},
            "temporal_signals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "temporal_signal_version": {"const": "2.0"},
                  "itinerary_dates": {"$ref": "#/$defs/itinerary_dates"}
                }
              }
            },
            "provider_scope": {"$ref": "#/$defs/provider_scope"},
            "discovery_provenance": {"type": "array", "items": {"type": "object"}}
            ,"internal_surface_transfer": {"type": "object"}
            ,"proposal": {"type": "object"}
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
