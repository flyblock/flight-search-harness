{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/round-trip-observations.schema.json",
  "title": "AI browser observations v0.4.0",
  "type": "object",
  "required": ["observation_version", "bundle_id", "task_id", "observations"],
  "properties": {
    "observation_version": {"const": "0.4.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "coverage_complete": {"type": "boolean", "default": true},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {"type": "object", "required": ["observation_id", "evidence_status"], "properties": {"observation_id": {"type": "string"}, "source_id": {"type": "string"}, "evidence_status": {"enum": ["ai_proposed", "verified_observed", "research_observed", "no_result", "rejected"]}, "provider": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "observed_at": {"type": "string", "format": "date-time"}, "proposal_type": {"enum": ["region_scope", "region_scope_challenge", "structural_challengers"]}, "proposed_by": {"const": "ai"}, "proposed_at": {"type": "string", "format": "date-time"}}},
    "observation": {
      "allOf": [
        {"$ref": "#/$defs/identity"},
        {
          "type": "object",
          "properties": {
            "reason": {"type": "string"},
            "nodes": {"type": "array", "items": {"type": "object"}},
            "movements": {"type": "array", "items": {"type": "object"}},
            "offer": {"type": "object"},
            "gateway_candidates": {"type": "array", "items": {"type": "object"}},
            "temporal_signals": {"type": "array", "items": {"type": "object"}},
            "discovery_provenance": {"type": "array", "items": {"type": "object"}}
            ,"proposal": {"type": "object"}
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
