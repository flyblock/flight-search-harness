{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/browser-task-brief.schema.json",
  "title": "AI browser task brief v0.5.0",
  "type": "object",
  "required": ["brief_version", "task_id", "task_status", "hypothesis", "research_kind", "query_shape", "traveler_count", "baggage_policy", "source_options", "dynamic_source_rules", "source_policy", "temporal_execution", "evidence_contract", "terminal_evidence_contract", "observations_template"],
  "properties": {
    "brief_version": {"const": "0.5.0"},
    "task_id": {"type": "string"},
    "task_status": {"enum": ["candidate", "pending"]},
    "hypothesis": {"type": "object"},
    "research_kind": {"enum": ["region_scope_definition", "region_pool_fare_screen", "priced_offer"]},
    "query_shape": {"type": "object"},
    "traveler_count": {"type": "integer", "minimum": 1},
    "baggage_policy": {"type": "object", "required": ["required_items", "paid_baggage_allowed"], "properties": {"required_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "paid_baggage_allowed": {"type": "boolean"}}, "additionalProperties": false},
    "source_options": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "dynamic_source_rules": {"type": "array", "items": {"type": "object"}},
    "source_policy": {"type": "object"},
    "temporal_execution": {"type": "object"},
    "evidence_contract": {"type": "object"},
    "terminal_evidence_contract": {"type": "object"},
    "observations_template": {"type": "object"}
  },
  "additionalProperties": false
}
