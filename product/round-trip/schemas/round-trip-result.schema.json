{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/round-trip-result.schema.json",
  "title": "Round-trip final result v0.4.0",
  "type": "object",
  "required": [
    "result_version",
    "session_id",
    "trip_scope",
    "search_status",
    "incomplete",
    "best_portfolio",
    "candidate_slate",
    "cost_scope",
    "price_observations",
    "journey_movements",
    "portfolios",
    "portfolio_kind_counts",
    "gateway_candidates",
    "region_scopes",
    "temporal_research",
    "offer_sets",
    "solver_projection",
    "hypothesis_outcomes",
    "finalization_audit",
    "search_stopping",
    "searched_scope",
    "unsearched_scope"
  ],
  "properties": {
    "result_version": {"const": "0.4.0"},
    "session_id": {"type": "string", "minLength": 1},
    "trip_scope": {"const": "round_trip"},
    "search_status": {"enum": ["final", "draft"]},
    "incomplete": {"type": "boolean"},
    "reason": {"type": ["string", "null"]},
    "best_portfolio": {"type": ["object", "null"]},
    "candidate_slate": {
      "type": "object",
      "required": [
        "candidate_slate_version",
        "status",
        "ranking_method",
        "ranking_scope",
        "entries"
      ],
      "properties": {
        "candidate_slate_version": {"const": "2.0"},
        "status": {"const": "bounded_complete"},
        "ranking_method": {"const": "mandatory_air_ticket_total_ascending"},
        "ranking_scope": {
          "enum": ["complete_evidence_ledger", "bounded_solver_projection"]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "route_alternative_id",
              "portfolio_id",
              "portfolio_kind",
              "comparison_total",
              "mandatory_air_ticket_total",
              "cost_scope",
              "outbound",
              "return",
              "selected_offers",
              "selected_movements",
              "ticketing_structures",
              "rank"
            ],
            "properties": {
              "route_alternative_id": {"type": "string", "minLength": 1},
              "portfolio_id": {"type": "string", "minLength": 1},
              "portfolio_kind": {"type": "string", "minLength": 1},
              "comparison_total": {"type": "object"},
              "mandatory_air_ticket_total": {"type": "object"},
              "cost_scope": {"type": "object"},
              "outbound": {"type": "object"},
              "return": {"type": "object"},
              "total_elapsed_minutes": {"type": ["integer", "null"]},
              "self_transfer_count": {"type": ["integer", "null"]},
              "overnight_connection_count": {"type": ["integer", "null"]},
              "travel_window_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "selected_offers": {"type": "array", "items": {"type": "object"}},
              "selected_movements": {"type": "array", "items": {"type": "object"}},
              "internal_surface_transfers": {"type": "array", "items": {"type": "object"}},
              "evidence_freshness": {"type": "object"},
              "ticketing_structures": {"type": "array", "minItems": 1, "items": {"type": "object"}},
              "rank": {"type": "integer", "minimum": 1},
              "price_delta_from_rank_1": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cost_scope": {"type": ["object", "null"]},
    "price_observations": {"type": "array", "items": {"type": "object"}},
    "journey_movements": {"type": "array", "items": {"type": "object"}},
    "portfolios": {"type": "array", "items": {"type": "object"}},
    "portfolio_kind_counts": {"type": "object"},
    "gateway_candidates": {"type": "object"},
    "region_scopes": {"type": "object"},
    "temporal_research": {"type": "object"},
    "offer_sets": {"type": "object"},
    "solver_projection": {"type": "object"},
    "hypothesis_outcomes": {"type": "array", "items": {"type": "object"}},
    "finalization_audit": {"type": "object"},
    "search_stopping": {"type": "object"},
    "searched_scope": {"type": "object"},
    "unsearched_scope": {"type": "object"}
  },
  "additionalProperties": false
}
