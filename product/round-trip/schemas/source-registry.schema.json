{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/source-registry.schema.json",
  "title": "Round-trip Provider source catalog v0.5.0",
  "type": "object",
  "required": ["registry_version", "catalog_origin", "not_a_whitelist", "decision_owner", "registry_order_is_preference", "sources", "dynamic_source_rules"],
  "properties": {
    "registry_version": {"const": "0.5.0"},
    "catalog_origin": {"type": "string"},
    "last_verified": {"type": "string"},
    "not_a_whitelist": {"const": true},
    "decision_owner": {"const": "ai"},
    "registry_order_is_preference": {"const": false},
    "sources": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "required": ["source_id", "name", "url", "source_type", "evidence_role", "modes", "regions", "capabilities", "browser_notes"],
        "properties": {
          "source_id": {"type": "string"},
          "name": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_type": {"type": "string"},
          "evidence_role": {"enum": ["payable_offer", "payable_offer_when_seller_visible", "research_only_until_payable_seller_verified"]},
          "modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "regions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "browser_notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "dynamic_source_rules": {"type": "array", "minItems": 3, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
