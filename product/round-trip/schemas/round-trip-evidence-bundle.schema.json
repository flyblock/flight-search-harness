{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/round-trip-evidence-bundle.schema.json",
  "title": "Immutable round-trip evidence bundle v0.4.0",
  "type": "object",
  "required": ["evidence_version", "bundle_id", "task_id", "evidence_status", "coverage_complete", "nodes", "gateway_candidates", "temporal_signals", "provider_scopes", "ai_proposals", "movements", "offers", "observations"],
  "properties": {
    "evidence_version": {"const": "0.4.0"},
    "bundle_id": {"type": "string"},
    "task_id": {"type": "string"},
    "evidence_status": {"enum": ["ai_proposed", "verified_observed", "research_observed", "no_result", "rejected"]},
    "coverage_complete": {"type": "boolean"},
    "nodes": {"type": "array", "items": {"type": "object"}},
    "gateway_candidates": {"type": "array", "items": {"$ref": "#/$defs/gateway_candidate"}},
    "temporal_signals": {"type": "array", "items": {"type": "object"}},
    "provider_scopes": {"type": "array", "items": {"type": "object"}},
    "ai_proposals": {"type": "array", "items": {"type": "object"}},
    "movements": {"type": "array", "items": {"type": "object"}},
    "offers": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "money": {"type": "object", "required": ["amount", "currency"], "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}, "additionalProperties": false},
    "gateway_signal": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "dated_fare_amount": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/money"}]},
        "date_coverage": {"enum": ["sampled_date_pair", "exact_dates", "bounded_window"]},
        "complete_cost_lower_bound": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/money"}]},
        "access_cost": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/money"}]},
        "opposite_gateway_node_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"required": ["dated_fare_amount"]}, "then": {"required": ["date_coverage", "opposite_gateway_node_id"]}},
        {"if": {"required": ["complete_cost_lower_bound"]}, "then": {"required": ["opposite_gateway_node_id"]}}
      ],
      "additionalProperties": true
    },
    "gateway_candidate": {"type": "object", "required": ["candidate_id", "side", "node", "signal"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "side": {"enum": ["origin", "destination"]}, "node": {"type": "object"}, "signal": {"$ref": "#/$defs/gateway_signal"}}, "additionalProperties": true}
  }
}
