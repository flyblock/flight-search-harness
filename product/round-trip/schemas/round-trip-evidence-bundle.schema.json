{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/round-trip/schemas/round-trip-evidence-bundle.schema.json",
  "title": "Immutable round-trip evidence bundle v0.4.0",
  "type": "object",
  "required": ["evidence_version", "bundle_id", "task_id", "evidence_status", "coverage_complete", "nodes", "gateway_candidates", "ai_proposals", "movements", "offers", "observations"],
  "properties": {
    "evidence_version": {"const": "0.4.0"},
    "bundle_id": {"type": "string"},
    "task_id": {"type": "string"},
    "evidence_status": {"enum": ["ai_proposed", "verified_observed", "research_observed", "no_result", "rejected"]},
    "coverage_complete": {"type": "boolean"},
    "nodes": {"type": "array", "items": {"type": "object"}},
    "gateway_candidates": {"type": "array", "items": {"type": "object"}},
    "temporal_signals": {"type": "array", "items": {"type": "object"}},
    "ai_proposals": {"type": "array", "items": {"type": "object"}},
    "movements": {"type": "array", "items": {"type": "object"}},
    "offers": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
