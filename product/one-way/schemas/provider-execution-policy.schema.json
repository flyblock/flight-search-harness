{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/provider-execution-policy.schema.json",
  "title": "Provider execution policy v0.7.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "registry_file", "semantics", "source_policies", "dynamic_rule_policies"],
  "properties": {
    "policy_version": {"const": "0.7.1"},
    "registry_file": {"type": "string", "minLength": 1},
    "semantics": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "minLength": 1}},
    "source_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policy"}},
    "dynamic_rule_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policy"}}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "execution_kind", "admission_policy", "activation", "task_families"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "execution_kind": {"enum": ["ai_browser_offer_discovery", "ai_browser_research", "ai_browser_direct_operator", "structured_research", "configured_structured_source", "configured_routing_engine", "dynamic_official_confirmation", "dynamic_structured_discovery"]},
        "admission_policy": {"type": "string", "minLength": 1},
        "activation": {"enum": ["global_modes", "regional_modes", "identified_operator", "regional_market_or_identified_operator", "configured_source", "discovered_carrier", "discovered_operator", "discovered_transport_authority"]},
        "task_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["baseline", "market", "reverse", "corridor_calendar", "budgeted_predecessor", "bridge", "refresh"]}
        }
      }
    }
  }
}
