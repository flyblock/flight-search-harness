{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/schemas/scenario-intent.schema.json",
  "title": "AI-structured one-way scenario intent v0.7.1",
  "description": "Input contract for deterministic materialization. The AI supplies seed nodes; the materializer does not browse or embed a world transport catalog.",
  "type": "object",
  "required": [
    "intent_id",
    "trip_scope",
    "trip_mode",
    "currency",
    "currency_decimal_places",
    "traveler_count",
    "baggage",
    "overnight_allowed",
    "self_transfer_policy",
    "origin",
    "destination",
    "date_window"
  ],
  "properties": {
    "intent_version": {"const": "0.7.1", "default": "0.7.1"},
    "intent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "profile_name": {"type": "string", "minLength": 1},
    "trip_scope": {"const": "one_way"},
    "trip_mode": {"const": "fixed_destination"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "currency_decimal_places": {"type": "integer", "minimum": 0, "maximum": 6},
    "traveler_count": {"type": "integer", "minimum": 1},
    "origin": {"$ref": "#/$defs/region_side"},
    "destination": {"$ref": "#/$defs/region_side"},
    "date_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "end": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        }
      },
      "additionalProperties": false
    },
    "date_flexibility": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["exact_dates", "bounded_window", "fully_flexible"],
          "default": "bounded_window"
        },
        "exact_departure_dates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "exact_dates"}}},
          "then": {"required": ["exact_departure_dates"]}
        }
      ],
      "additionalProperties": false,
      "default": {"mode": "bounded_window"}
    },
    "query_budget": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null,
      "description": "Optional user-requested hard cap on external browser attempts. Null leaves stopping to the AI and user."
    },
    "budget": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/money_input"}
      ],
      "description": "Optional hard total budget. Null or omission means unbounded."
    },
    "strategy": {
      "enum": ["lowest_price", "shortest_time", "convenience", "balanced", "extreme_savings"],
      "default": "extreme_savings"
    },
    "allowed_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/mode"}
    },
    "baggage": {
      "type": "object",
      "required": ["mode", "paid_baggage"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "paid_baggage": {"type": "boolean"},
        "customized": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "transport_entitlements": {"type": "array", "items": {"type": "object"}},
    "fx_to_base": {
      "type": "object",
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    },
    "fx_snapshot": {"$ref": "#/$defs/fx_snapshot"},
    "require_fresh_fx_snapshot": {"type": "boolean", "default": false},
    "fx_as_of": {"type": "string", "format": "date-time"},
    "overnight_allowed": {"type": "boolean"},
    "accommodation_cost_policy": {
      "enum": ["include_required", "exclude_from_optimization"],
      "default": "include_required",
      "description": "Exclude only explicitly observed required accommodation from optimization when the user treats a stop as a discretionary visit."
    },
    "self_transfer_policy": {"enum": ["allow", "never"]},
    "mode_transition_buffers_minutes": {"$ref": "#/$defs/mode_transition_buffers_minutes"}
  },
  "additionalProperties": false,
  "$defs": {
    "mode_transition_buffers_minutes": {
      "type": "object",
      "properties": {
        "surface_to_flight": {"type": "integer", "minimum": 0, "default": 120},
        "self_transfer_to_flight": {"type": "integer", "minimum": 0, "default": 120},
        "flight_to_flight": {"type": "integer", "minimum": 0, "default": 60},
        "flight_to_surface": {"type": "integer", "minimum": 0, "default": 0},
        "surface_to_surface": {"type": "integer", "minimum": 0, "default": 0}
      },
      "additionalProperties": false
    },
    "fx_snapshot": {
      "type": "object",
      "required": [
        "base_currency",
        "rates",
        "source_url",
        "provider",
        "observed_at",
        "expires_at"
      ],
      "properties": {
        "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "rates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Z]{3}$"},
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "source_url": {"type": "string", "format": "uri"},
        "provider": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "region_side": {
      "type": "object",
      "required": ["region_id", "label", "country_codes", "seed_nodes"],
      "properties": {
        "region_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "label": {"type": "string", "minLength": 1},
        "country_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
        },
        "policy": {"enum": ["exact", "city_region", "extended_region"], "default": "extended_region"},
        "seed_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "region-node.schema.json"}
        },
        "max_access_time_minutes": {"type": ["integer", "null"], "minimum": 0},
        "max_egress_time_minutes": {"type": ["integer", "null"], "minimum": 0},
        "max_ground_cost": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/money_input"}
          ]
        },
        "allowed_ground_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ground_mode"}
        },
        "expansion": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "provider_kinds": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["browser_search", "region_catalog", "scheduled_transport", "road_routing"]}
            },
            "max_discovered_nodes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "additionalProperties": false
    },
    "money_input": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"$ref": "#/$defs/money"}
      ]
    },
    "mode": {
      "enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]
    },
    "ground_mode": {
      "enum": ["rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]
    }
  }
}
