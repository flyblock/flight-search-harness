{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/schemas/residual-budget-policy.schema.json",
  "title": "Residual-budget recursive search policy v0.7.1",
  "description": "Configuration contract for bounded one-way search to a selected destination. The search works backward from verified destination-side suffixes while preserving a forward frontier.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "policy_id",
    "trip_mode",
    "journey_direction",
    "base_currency",
    "currency_decimal_places",
    "strict_improvement_delta",
    "scope",
    "incumbent_total_cost",
    "incumbent_evidence",
    "date_time_constraints",
    "reverse_search",
    "lower_bound_policy",
    "query_budgets",
    "query_priority",
    "diversity_quotas",
    "unknown_edge_policy",
    "price_integrity",
    "safe_pruning",
    "result_disclosure"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "0.7.1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "trip_mode": {"const": "fixed_destination"},
    "journey_direction": {"const": "one_way"},
    "base_currency": {"$ref": "#/$defs/currency"},
    "currency_decimal_places": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "Decimal places used for exact base-currency arithmetic."
    },
    "strict_improvement_delta": {
      "$ref": "#/$defs/positive_money",
      "description": "Minimum amount by which a price-improvement candidate must beat the incumbent."
    },
    "scope": {"$ref": "#/$defs/search_scope"},
    "incumbent_total_cost": {
      "$ref": "#/$defs/money",
      "description": "Verified complete-itinerary upper bound. Its currency must equal base_currency."
    },
    "incumbent_evidence": {"$ref": "#/$defs/incumbent_evidence"},
    "date_time_constraints": {"$ref": "#/$defs/date_time_constraints"},
    "reverse_search": {"$ref": "#/$defs/reverse_search"},
    "lower_bound_policy": {"$ref": "#/$defs/lower_bound_policy"},
    "query_budgets": {"$ref": "#/$defs/query_budgets"},
    "query_priority": {"$ref": "#/$defs/query_priority"},
    "diversity_quotas": {"$ref": "#/$defs/diversity_quotas"},
    "unknown_edge_policy": {"$ref": "#/$defs/unknown_edge_policy"},
    "price_integrity": {"$ref": "#/$defs/price_integrity"},
    "safe_pruning": {"$ref": "#/$defs/safe_pruning"},
    "result_disclosure": {"$ref": "#/$defs/result_disclosure"},
    "budget_arithmetic_test_vector": {"$ref": "#/$defs/budget_arithmetic_test_vector"}
  },
  "additionalProperties": false,
  "$defs": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"$ref": "#/$defs/currency"}
      },
      "additionalProperties": false
    },
    "positive_money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"$ref": "#/$defs/currency"}
      },
      "additionalProperties": false
    },
    "transport_mode": {
      "enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]
    },
    "search_scope": {
      "type": "object",
      "required": [
        "origin_pool_ids",
        "destination_pool_ids",
        "authorized_geographic_scope_ids",
        "allow_discovered_intermediate_nodes",
        "discovered_nodes_must_be_authorized"
      ],
      "properties": {
        "origin_pool_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "destination_pool_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authorized_geographic_scope_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Explicit regions within which provider research may discover intermediate nodes.",
          "items": {"type": "string", "minLength": 1}
        },
        "allow_discovered_intermediate_nodes": {"const": true},
        "discovered_nodes_must_be_authorized": {"const": true}
      },
      "additionalProperties": false
    },
    "incumbent_evidence": {
      "type": "object",
      "required": ["candidate_id", "evidence_status", "complete_itinerary", "atomic_offer_ids", "observed_at"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "evidence_status": {"const": "confirmed"},
        "complete_itinerary": {"const": true},
        "atomic_offer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "date_time_constraints": {
      "type": "object",
      "required": [
        "departure_not_before",
        "complete_not_after",
        "minimum_connection_minutes",
        "maximum_connection_minutes",
        "maximum_total_travel_minutes",
        "require_complete_within_window",
        "timestamp_policy"
      ],
      "properties": {
        "departure_not_before": {"type": "string", "format": "date-time"},
        "complete_not_after": {"type": "string", "format": "date-time"},
        "minimum_connection_minutes": {"type": "integer", "minimum": 0},
        "maximum_connection_minutes": {"type": "integer", "minimum": 1},
        "maximum_total_travel_minutes": {"type": "integer", "minimum": 1},
        "require_complete_within_window": {"const": true},
        "timestamp_policy": {"const": "offset_required"}
      },
      "additionalProperties": false
    },
    "reverse_search": {
      "type": "object",
      "required": [
        "strategy",
        "seed_from_destination_pool",
        "preserve_forward_frontier",
        "recompute_remaining_budget_after_verified_suffix",
        "remaining_budget_formula",
        "maximum_recursion_depth",
        "maximum_labels_per_node"
      ],
      "properties": {
        "strategy": {"const": "residual_budget_bidirectional_recursive"},
        "seed_from_destination_pool": {"const": true},
        "preserve_forward_frontier": {"const": true},
        "recompute_remaining_budget_after_verified_suffix": {"const": true},
        "remaining_budget_formula": {"const": "incumbent_total_cost - verified_cost_to_destination - strict_improvement_delta"},
        "maximum_recursion_depth": {"type": "integer", "minimum": 1},
        "maximum_labels_per_node": {"type": "integer", "minimum": 1},
        "maximum_total_legs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "lower_bound_policy": {
      "type": "object",
      "required": [
        "prune_only_with_proven_admissible_bound",
        "unknown_cost_floor",
        "combine_proven_bounds",
        "heuristics_may_rank_queries",
        "heuristics_may_prune",
        "heuristic_classification",
        "estimators"
      ],
      "properties": {
        "prune_only_with_proven_admissible_bound": {"const": true},
        "unknown_cost_floor": {"$ref": "#/$defs/money"},
        "combine_proven_bounds": {"const": "maximum"},
        "heuristics_may_rank_queries": {"const": true},
        "heuristics_may_prune": {"const": false},
        "heuristic_classification": {
          "type": "object",
          "required": ["observed_price_floor", "historical_price", "ai_estimate"],
          "properties": {
            "observed_price_floor": {"const": "heuristic_not_safe_for_pruning"},
            "historical_price": {"const": "heuristic_not_safe_for_pruning"},
            "ai_estimate": {"const": "heuristic_not_safe_for_pruning"}
          },
          "additionalProperties": false
        },
        "estimators": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/lower_bound_estimator"}
        }
      },
      "additionalProperties": false
    },
    "lower_bound_estimator": {
      "type": "object",
      "required": ["estimator_id", "dimension", "bound_kind", "method", "admissible_for_pruning", "safety_basis"],
      "properties": {
        "estimator_id": {"type": "string", "minLength": 1},
        "dimension": {"enum": ["cost", "duration"]},
        "bound_kind": {"enum": ["proven_admissible", "heuristic"]},
        "method": {"type": "string", "minLength": 1},
        "admissible_for_pruning": {"type": "boolean"},
        "safety_basis": {
          "enum": ["mathematical_zero", "exact_verified_component", "provider_guaranteed_floor", "hard_constraint", "none"]
        },
        "evidence_required": {"type": "boolean"},
        "maximum_evidence_age_minutes": {"type": ["integer", "null"], "minimum": 0},
        "allowed_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["safe_prune", "query_ranking", "exploration_ranking", "display_estimate"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"bound_kind": {"const": "proven_admissible"}}, "required": ["bound_kind"]},
          "then": {
            "properties": {
              "admissible_for_pruning": {"const": true},
              "safety_basis": {"enum": ["mathematical_zero", "exact_verified_component", "provider_guaranteed_floor", "hard_constraint"]}
            }
          }
        },
        {
          "if": {"properties": {"bound_kind": {"const": "heuristic"}}, "required": ["bound_kind"]},
          "then": {
            "properties": {
              "admissible_for_pruning": {"const": false},
              "safety_basis": {"const": "none"},
              "allowed_uses": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["query_ranking", "exploration_ranking", "display_estimate"]}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"method": {"enum": ["observed_price_floor", "historical_price", "ai_estimate"]}},
            "required": ["method"]
          },
          "then": {
            "properties": {
              "bound_kind": {"const": "heuristic"},
              "admissible_for_pruning": {"const": false},
              "safety_basis": {"const": "none"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "query_budgets": {
      "type": "object",
      "required": [
        "total_queries",
        "flight_discovery_queries",
        "connector_research_queries",
        "offer_refresh_queries",
        "browser_research_queries",
        "maximum_parallel_queries",
        "wall_clock_seconds"
      ],
      "properties": {
        "total_queries": {"type": "integer", "minimum": 1},
        "flight_discovery_queries": {"type": "integer", "minimum": 0},
        "connector_research_queries": {"type": "integer", "minimum": 0},
        "offer_refresh_queries": {"type": "integer", "minimum": 0},
        "browser_research_queries": {"type": "integer", "minimum": 0},
        "maximum_parallel_queries": {"type": "integer", "minimum": 1},
        "wall_clock_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "query_priority": {
      "type": "object",
      "required": [
        "formula",
        "expected_improvement_metric",
        "query_cost_unit",
        "minimum_expected_improvement",
        "minimum_improvement_probability",
        "refresh_expired_evidence_before_execution",
        "objective_lanes",
        "query_identity"
      ],
      "properties": {
        "formula": {"const": "expected_improvement_divided_by_query_cost"},
        "expected_improvement_metric": {"const": "complete_total_trip_cost_reduction"},
        "query_cost_unit": {"enum": ["provider_request", "browser_action", "wall_clock_second", "composite_credit"]},
        "minimum_expected_improvement": {"$ref": "#/$defs/money"},
        "minimum_improvement_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "refresh_expired_evidence_before_execution": {"const": true},
        "objective_lanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["price_improvement", "pareto_exploration"]},
          "allOf": [
            {"contains": {"const": "price_improvement"}},
            {"contains": {"const": "pareto_exploration"}}
          ]
        },
        "query_identity": {
          "type": "object",
          "required": ["logical_query_key", "attempt_key", "incumbent_epoch_required"],
          "properties": {
            "logical_query_key": {"const": "logical_query_id"},
            "attempt_key": {"const": "attempt_id"},
            "incumbent_epoch_required": {"const": true}
          },
          "additionalProperties": false
        },
        "tie_breakers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["region_diversity", "mode_diversity", "route_shape_diversity", "lower_query_cost", "older_queue_age"]}
        }
      },
      "additionalProperties": false
    },
    "quota": {
      "type": "object",
      "required": ["enabled", "minimum_distinct_buckets", "maximum_labels_per_bucket", "reserved_exploration_slots"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minimum_distinct_buckets": {"type": "integer", "minimum": 1},
        "maximum_labels_per_bucket": {"type": "integer", "minimum": 1},
        "reserved_exploration_slots": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "diversity_quotas": {
      "type": "object",
      "required": ["region", "mode", "route_shape", "quota_eviction_is_not_safe_pruning"],
      "properties": {
        "region": {"$ref": "#/$defs/quota"},
        "mode": {"$ref": "#/$defs/quota"},
        "route_shape": {"$ref": "#/$defs/quota"},
        "quota_eviction_is_not_safe_pruning": {"const": true}
      },
      "additionalProperties": false
    },
    "unknown_edge_policy": {
      "type": "object",
      "required": [
        "status",
        "allow_in_research_queue",
        "allow_in_verified_cost",
        "allow_in_bookable_itinerary",
        "require_external_evidence_before_promotion",
        "candidate_modes"
      ],
      "properties": {
        "status": {"const": "research_only"},
        "allow_in_research_queue": {"const": true},
        "allow_in_verified_cost": {"const": false},
        "allow_in_bookable_itinerary": {"const": false},
        "require_external_evidence_before_promotion": {"const": true},
        "candidate_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/transport_mode"}
        }
      },
      "additionalProperties": false
    },
    "price_integrity": {
      "type": "object",
      "required": [
        "price_scope",
        "atomic_offer_snapshot_required",
        "movement_price_allocation_must_be_provider_itemized",
        "movement_prices_must_not_be_inferred",
        "deduplicate_atomic_offer_ids",
        "mandatory_costs_counted_once"
      ],
      "properties": {
        "price_scope": {"const": "atomic_offer"},
        "atomic_offer_snapshot_required": {"const": true},
        "movement_price_allocation_must_be_provider_itemized": {"const": true},
        "movement_prices_must_not_be_inferred": {"const": true},
        "deduplicate_atomic_offer_ids": {"const": true},
        "mandatory_costs_counted_once": {"const": true}
      },
      "additionalProperties": false
    },
    "safe_pruning": {
      "type": "object",
      "required": ["enabled", "require_machine_readable_reason", "allowed_reason_classes", "heuristic_only_prune_forbidden", "price_improvement_prune_rule"],
      "properties": {
        "enabled": {"const": true},
        "require_machine_readable_reason": {"const": true},
        "allowed_reason_classes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["hard_constraint", "proven_admissible_lower_bound"]},
          "allOf": [
            {"contains": {"const": "hard_constraint"}},
            {"contains": {"const": "proven_admissible_lower_bound"}}
          ]
        },
        "heuristic_only_prune_forbidden": {"const": true},
        "price_improvement_prune_rule": {"const": "prefix_proven_lower_bound_greater_than_remaining_budget"}
      },
      "additionalProperties": false
    },
    "result_disclosure": {
      "type": "object",
      "required": ["not_global_optimum", "global_optimum_claimed", "required_statement", "report_coverage_limits"],
      "properties": {
        "not_global_optimum": {"const": true},
        "global_optimum_claimed": {"const": false},
        "required_statement": {"const": "Best observed within configured providers, pools, date window, evidence freshness, and query budgets; not a proven global optimum."},
        "report_coverage_limits": {"const": true}
      },
      "additionalProperties": false
    },
    "budget_arithmetic_test_vector": {
      "type": "object",
      "description": "Optional executable arithmetic example: remaining = incumbent - verified suffix - strict improvement delta.",
      "required": ["incumbent_total_cost", "verified_cost_to_destination", "strict_improvement_delta", "expected_remaining_budget"],
      "properties": {
        "incumbent_total_cost": {"$ref": "#/$defs/money"},
        "verified_cost_to_destination": {"$ref": "#/$defs/money"},
        "strict_improvement_delta": {"$ref": "#/$defs/positive_money"},
        "expected_remaining_budget": {"$ref": "#/$defs/money"}
      },
      "additionalProperties": false
    }
  }
}
