{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/schemas/live-evidence-bundle.schema.json",
  "title": "One-way live browser evidence bundle v0.7.1",
  "description": "Evidence returned for one current browser-provider task with authorized node discovery, atomic multi-leg offers, flight identity, provider-specific offer snapshots, and research-to-seller provenance.",
  "type": "object",
  "required": ["bundle_version", "bundle_id", "request_id", "observations"],
  "properties": {
    "bundle_version": {
      "const": "0.7.1",
      "description": "Must equal the evidence_contract_version of the issued task."
    },
    "bundle_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "discovered_nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/discovered_node"}
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"bundle_version": {"enum": ["0.7.0", "0.7.1"]}},
        "required": ["bundle_version"]
      },
      "then": {
        "properties": {
          "observations": {
            "items": {"$ref": "#/$defs/observation_v070"}
          }
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "discovered_node": {
      "type": "object",
      "description": "A task-authorized endpoint discovered by the provider. It is not admitted unless the runtime also verifies the task endpoint policy and node consistency.",
      "required": [
        "node_id",
        "node_type",
        "location",
        "country_or_region",
        "timezone",
        "source_url",
        "observed_at"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "node_type": {
          "enum": ["airport", "railway_station", "bus_terminal", "ferry_terminal", "city_destination"]
        },
        "location": {"type": "string", "minLength": 1},
        "country_or_region": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "timezone": {"type": "string", "minLength": 1},
        "coordinates": {"$ref": "#/$defs/coordinates"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "observed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "endpoint_policy": {
      "type": "object",
      "description": "Canonical endpoint scope emitted by a v0.7.0 task. exact_node fixes an endpoint, node_pool limits it to the issued pool, and provider_authorized_anywhere permits sourced discovery only on that side.",
      "required": ["from", "to"],
      "properties": {
        "from": {"enum": ["exact_node", "node_pool", "provider_authorized_anywhere"]},
        "to": {"enum": ["exact_node", "node_pool", "provider_authorized_anywhere"]}
      },
      "additionalProperties": false
    },
    "task_contract": {
      "type": "object",
      "description": "Reusable schema fragment for the endpoint portion of an issued task; the evidence bundle references that task by request_id rather than repeating it.",
      "required": ["task_id", "evidence_contract_version", "endpoint_policy"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "evidence_contract_version": {"const": "0.7.1"},
        "endpoint_policy": {"$ref": "#/$defs/endpoint_policy"}
      },
      "additionalProperties": true
    },
    "common": {
      "type": "object",
      "required": ["observation_id", "evidence_status", "provider", "url", "observed_at"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "evidence_status": {"enum": ["verified_observed", "no_result", "rejected"]},
        "provider": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "observed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "discovery_provenance": {
      "type": "array",
      "minItems": 1,
      "description": "Research-only discovery chain. It is preserved for audit but is never route-admissible and never contributes to cost.",
      "items": {
        "type": "object",
        "required": ["provider", "url", "observed_at", "purpose", "admission_status"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "observed_at": {"type": "string", "format": "date-time"},
          "purpose": {"enum": ["itinerary_and_fare_rule_discovery", "route_discovery", "calendar_anchor", "price_indication"]},
          "admission_status": {"const": "research_only"},
          "displayed_price": {"$ref": "#/$defs/money"},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "baggage": {
      "type": "object",
      "required": ["status", "included_personal_item", "mandatory_cost"],
      "properties": {
        "status": {"enum": ["confirmed", "not_applicable"]},
        "included_personal_item": {"type": "boolean"},
        "mandatory_cost": {"$ref": "#/$defs/money"}
      },
      "additionalProperties": false
    },
    "atomic_component_segment": {
      "type": "object",
      "required": ["component_id", "from_node", "to_node", "mode", "departure", "arrival"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "from_node": {"type": "string", "minLength": 1},
        "to_node": {"type": "string", "minLength": 1},
        "mode": {"enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]},
        "departure": {"type": "string", "format": "date-time"},
        "arrival": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "ticket_context": {
      "type": "object",
      "description": "One provider-priced atomic offer that may contain multiple physical movement components. The observation price is the indivisible offer total; component_edge_ids, via_nodes, and optional component timing segments carry no inferred segment prices.",
      "required": ["pricing_scope", "atomic_offer_id", "component_edge_ids"],
      "properties": {
        "pricing_scope": {"const": "atomic_offer"},
        "atomic_offer_id": {"type": "string", "minLength": 1},
        "component_edge_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "via_nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/atomic_component_segment"}
        },
        "use_pattern": {"const": "planned_exit_at_connection"},
        "ticketed_final_node": {"type": "string", "minLength": 1},
        "planned_exit_node": {"type": "string", "minLength": 1},
        "used_component_edge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unused_component_edge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "used_via_nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "if": {
        "required": ["use_pattern"]
      },
      "then": {
        "required": [
          "segments",
          "ticketed_final_node",
          "planned_exit_node",
          "used_component_edge_ids",
          "unused_component_edge_ids",
          "used_via_nodes"
        ]
      },
      "additionalProperties": false
    },
    "unknown_reason": {
      "type": "object",
      "description": "Structured reason why a source did not disclose a flight number. It records absence; it must never be replaced by a guessed identifier.",
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "not_disclosed_by_source",
            "not_visible_in_search_result",
            "provider_omitted"
          ]
        },
        "detail": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "flight_identity": {
      "type": "object",
      "description": "Observed carrier identity plus every disclosed flight number. A missing number requires an explicit structured unknown_reason; the collector must not infer one.",
      "properties": {
        "marketing_carrier": {"type": "string", "minLength": 1},
        "operating_carrier": {"type": "string", "minLength": 1},
        "flight_numbers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "unknown_reason": {"$ref": "#/$defs/unknown_reason"}
      },
      "allOf": [
        {
          "anyOf": [
            {"required": ["marketing_carrier"]},
            {"required": ["operating_carrier"]}
          ]
        },
        {
          "oneOf": [
            {"required": ["flight_numbers"]},
            {"required": ["unknown_reason"]}
          ]
        }
      ],
      "additionalProperties": false
    },
    "verified": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["from_node", "to_node", "mode", "departure", "arrival", "price", "baggage"],
          "properties": {
            "evidence_status": {"const": "verified_observed"},
            "from_node": {"type": "string", "minLength": 1},
            "to_node": {"type": "string", "minLength": 1},
            "mode": {"enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]},
            "departure": {"type": "string", "format": "date-time"},
            "arrival": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"},
            "price": {
              "allOf": [{"$ref": "#/$defs/money"}],
              "description": "The total provider price for this observation or its ticket_context atomic offer; never a fabricated per-segment allocation."
            },
            "baggage": {"$ref": "#/$defs/baggage"},
            "operator": {"type": "string"},
            "service_id": {"type": "string"},
            "provider_offer_id": {"type": "string", "minLength": 1},
            "discovery_provenance": {"$ref": "#/$defs/discovery_provenance"},
            "flight_identity": {"$ref": "#/$defs/flight_identity"},
            "independent_ticket_group": {"type": "string"},
            "entitlement_tags": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "border_crossing_count": {"type": "integer", "minimum": 0},
            "ticket_context": {"$ref": "#/$defs/ticket_context"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "terminal_non_offer": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "evidence_status": {"enum": ["no_result", "rejected"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "observation": {
      "oneOf": [
        {"$ref": "#/$defs/verified"},
        {"$ref": "#/$defs/terminal_non_offer"}
      ]
    },
    "verified_v070": {
      "allOf": [
        {"$ref": "#/$defs/verified"},
        {
          "if": {
            "properties": {"mode": {"const": "flight"}},
            "required": ["mode"]
          },
          "then": {"required": ["flight_identity"]}
        }
      ]
    },
    "observation_v070": {
      "oneOf": [
        {"$ref": "#/$defs/verified_v070"},
        {"$ref": "#/$defs/terminal_non_offer"}
      ]
    }
  }
}
