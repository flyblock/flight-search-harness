{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/provider-query-shapes.schema.json",
  "title": "Provider query-shape capabilities v1.0",
  "type": "object",
  "required": ["query_shape_version", "purpose", "default_support", "shapes", "sources"],
  "properties": {
    "query_shape_version": {"const": "1.0"},
    "purpose": {"type": "string", "minLength": 1},
    "default_support": {"enum": [true, false, "unknown"]},
    "shapes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "support", "evidence", "last_verified"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "support": {"type": "object", "additionalProperties": {"enum": [true, false, "unknown"]}},
          "evidence": {"type": "string", "minLength": 1},
          "last_verified": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
