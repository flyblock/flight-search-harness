{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/schemas/search-trace.schema.json",
  "title": "Bidirectional frontier search trace v0.7.1",
  "description": "Auditable trace for bounded multimodal search, including atomic provider offers, temporal labels, evidence transitions, pruning, budgets, and search coverage.",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "request",
    "policy_snapshot",
    "started_at",
    "ended_at",
    "run_status",
    "budget_usage",
    "quote_snapshots",
    "priced_offers",
    "evidence_records",
    "temporal_labels",
    "events",
    "candidates",
    "coverage",
    "termination"
  ],
  "properties": {
    "schema_version": {"const": "0.7.1"},
    "trace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "request": {"$ref": "#/$defs/search_request"},
    "policy_snapshot": {"$ref": "search-policy.schema.json"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "run_status": {
      "enum": ["running", "completed", "budget_exhausted", "failed", "cancelled"]
    },
    "budget_usage": {"$ref": "#/$defs/budget_usage"},
    "quote_snapshots": {
      "type": "array",
      "items": {"$ref": "#/$defs/quote_snapshot"}
    },
    "priced_offers": {
      "type": "array",
      "items": {"$ref": "#/$defs/priced_offer"}
    },
    "evidence_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_record"}
    },
    "temporal_labels": {
      "type": "array",
      "items": {"$ref": "#/$defs/temporal_label"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/trace_event"}
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "termination": {"$ref": "#/$defs/termination"}
  },
  "additionalProperties": false,
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "additionalProperties": false
    },
    "time_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "search_request": {
      "type": "object",
      "required": [
        "request_id",
        "trip_mode",
        "base_currency",
        "origin_pool_ids",
        "destination_pool_ids",
        "travel_window",
        "profile_fingerprint",
        "config_fingerprint"
      ],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "trip_mode": {
          "enum": ["fixed_destination", "round_trip_fixed_destination", "flexible_loop", "open_jaw", "multi_city"]
        },
        "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "accommodation_cost_policy": {
          "enum": ["include_required", "exclude_from_optimization"],
          "default": "include_required"
        },
        "origin_pool_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "destination_pool_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "travel_window": {"$ref": "#/$defs/time_range"},
        "profile_fingerprint": {"type": "string", "minLength": 1},
        "config_fingerprint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "budget_counter": {
      "type": "object",
      "required": ["limit", "used", "exhausted"],
      "properties": {
        "limit": {"type": "integer", "minimum": 0},
        "used": {"type": "integer", "minimum": 0},
        "exhausted": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "budget_usage": {
      "type": "object",
      "required": [
        "provider_queries_total",
        "flight_discovery_queries",
        "structured_route_queries",
        "browser_research_queries",
        "edge_refresh_queries",
        "hub_expansions",
        "connector_probes",
        "candidate_pairs_evaluated",
        "labels_created",
        "wall_clock_seconds"
      ],
      "properties": {
        "provider_queries_total": {"$ref": "#/$defs/budget_counter"},
        "flight_discovery_queries": {"$ref": "#/$defs/budget_counter"},
        "structured_route_queries": {"$ref": "#/$defs/budget_counter"},
        "browser_research_queries": {"$ref": "#/$defs/budget_counter"},
        "edge_refresh_queries": {"$ref": "#/$defs/budget_counter"},
        "hub_expansions": {"$ref": "#/$defs/budget_counter"},
        "connector_probes": {"$ref": "#/$defs/budget_counter"},
        "candidate_pairs_evaluated": {"$ref": "#/$defs/budget_counter"},
        "labels_created": {"$ref": "#/$defs/budget_counter"},
        "wall_clock_seconds": {"$ref": "#/$defs/budget_counter"}
      },
      "additionalProperties": false
    },
    "quote_snapshot": {
      "type": "object",
      "description": "Immutable observation context for one provider response. expires_at may be null when the provider publishes no validity time.",
      "required": [
        "quote_snapshot_id",
        "provider_id",
        "source_url",
        "observed_at",
        "expires_at",
        "content_fingerprint"
      ],
      "properties": {
        "quote_snapshot_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "content_fingerprint": {"type": "string", "minLength": 1},
        "provider_request_id": {"type": "string", "minLength": 1},
        "travel_date_scope": {"$ref": "#/$defs/time_range"}
      },
      "additionalProperties": false
    },
    "ticket_context": {
      "type": "object",
      "description": "Provider-stated ticket/order scope for a priced offer; it is independent from the number of physical movement legs.",
      "required": [
        "ticket_context_id",
        "journey_pricing_type",
        "order_scope",
        "ticketing_scope",
        "protected_connection"
      ],
      "properties": {
        "ticket_context_id": {"type": "string", "minLength": 1},
        "journey_pricing_type": {
          "enum": ["one_way", "round_trip", "open_jaw", "multi_city", "through_journey", "provider_bundle"]
        },
        "order_scope": {"enum": ["single_order", "multiple_orders", "unknown"]},
        "ticketing_scope": {"enum": ["single_ticket", "separate_tickets", "unknown"]},
        "protected_connection": {"type": ["boolean", "null"]},
        "fare_family": {"type": "string"},
        "provider_offer_reference": {"type": "string"}
      },
      "additionalProperties": false
    },
    "provider_price_component": {
      "type": "object",
      "required": ["component_id", "amount", "provider_itemization", "movement_edge_ids"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "amount": {"$ref": "#/$defs/money"},
        "provider_itemization": {"const": true},
        "movement_edge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "priced_offer": {
      "type": "object",
      "description": "One atomic provider price. A round trip or through fare may contain many movement edges; its price must not be invented by splitting or summing per-leg values.",
      "required": [
        "offer_id",
        "quote_snapshot_id",
        "ticket_context",
        "movement_edge_ids",
        "price_scope",
        "quoted_total",
        "quoted_total_includes",
        "movement_price_allocation",
        "movement_prices_must_not_be_inferred"
      ],
      "properties": {
        "offer_id": {"type": "string", "minLength": 1},
        "quote_snapshot_id": {"type": "string", "minLength": 1},
        "ticket_context": {"$ref": "#/$defs/ticket_context"},
        "movement_edge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "price_scope": {"const": "atomic_offer"},
        "quoted_total": {"$ref": "#/$defs/money"},
        "quoted_total_includes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "base_transport_price",
              "taxes",
              "mandatory_carrier_fees",
              "mandatory_baggage",
              "required_accommodation",
              "other_mandatory_costs"
            ]
          }
        },
        "mandatory_baggage_total": {"$ref": "#/$defs/money"},
        "other_mandatory_total": {"$ref": "#/$defs/money"},
        "movement_price_allocation": {"enum": ["not_allocated", "provider_itemized"]},
        "provider_price_components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/provider_price_component"}
        },
        "movement_prices_must_not_be_inferred": {"const": true},
        "bookability_status": {"enum": ["bookable", "quoted", "sold_out", "unknown"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"movement_price_allocation": {"const": "provider_itemized"}},
            "required": ["movement_price_allocation"]
          },
          "then": {"required": ["provider_price_components"]}
        },
        {
          "if": {
            "properties": {"movement_price_allocation": {"const": "not_allocated"}},
            "required": ["movement_price_allocation"]
          },
          "then": {"not": {"required": ["provider_price_components"]}}
        }
      ],
      "additionalProperties": false
    },
    "evidence_record": {
      "type": "object",
      "required": [
        "evidence_id",
        "provider_id",
        "source_url",
        "observed_at",
        "verification_status",
        "confidence"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "quote_snapshot_id": {"type": "string", "minLength": 1},
        "offer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "movement_edge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verification_status": {"$ref": "#/$defs/verification_status"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "temporal_label": {
      "type": "object",
      "description": "Time-dependent Pareto label. Forward labels carry earliest feasible arrival; backward labels carry latest feasible departure.",
      "required": [
        "label_id",
        "direction",
        "current_node_id",
        "earliest_feasible_arrival",
        "latest_feasible_departure",
        "cost_lower",
        "cost_upper",
        "elapsed_lower_minutes",
        "elapsed_upper_minutes",
        "ground_minutes",
        "wait_minutes",
        "transfers",
        "self_transfers",
        "overnights",
        "evidence_status",
        "unresolved_gap_count",
        "movement_edge_ids",
        "priced_offer_ids",
        "unpriced_movement_edge_ids"
      ],
      "properties": {
        "label_id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["forward", "backward"]},
        "current_node_id": {"type": "string", "minLength": 1},
        "earliest_feasible_arrival": {"type": ["string", "null"], "format": "date-time"},
        "latest_feasible_departure": {"type": ["string", "null"], "format": "date-time"},
        "time_zone": {"type": "string", "minLength": 1},
        "cost_lower": {"$ref": "#/$defs/money"},
        "cost_upper": {
          "oneOf": [
            {"$ref": "#/$defs/money"},
            {"type": "null"}
          ]
        },
        "elapsed_lower_minutes": {"type": "integer", "minimum": 0},
        "elapsed_upper_minutes": {"type": ["integer", "null"], "minimum": 0},
        "ground_minutes": {"type": "integer", "minimum": 0},
        "wait_minutes": {"type": "integer", "minimum": 0},
        "transfers": {"type": "integer", "minimum": 0},
        "self_transfers": {"type": "integer", "minimum": 0},
        "overnights": {"type": "integer", "minimum": 0},
        "evidence_status": {"$ref": "#/$defs/evidence_status"},
        "unresolved_gap_count": {"type": "integer", "minimum": 0},
        "movement_edge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "priced_offer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unpriced_movement_edge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "parent_label_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"direction": {"const": "forward"}}, "required": ["direction"]},
          "then": {"properties": {"earliest_feasible_arrival": {"type": "string", "format": "date-time"}}}
        },
        {
          "if": {"properties": {"direction": {"const": "backward"}}, "required": ["direction"]},
          "then": {"properties": {"latest_feasible_departure": {"type": "string", "format": "date-time"}}}
        }
      ],
      "additionalProperties": false
    },
    "trace_event": {
      "type": "object",
      "required": ["sequence", "at", "event_type"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "at": {"type": "string", "format": "date-time"},
        "event_type": {
          "enum": [
            "run_started",
            "conventional_reference_observed",
            "provider_query_started",
            "provider_query_completed",
            "quote_observed",
            "anchor_retained",
            "anchor_rejected",
            "pair_queued",
            "connector_probe_started",
            "connector_probe_completed",
            "temporal_label_created",
            "temporal_labels_joined",
            "candidate_created",
            "candidate_revalidated",
            "candidate_emitted",
            "evidence_status_changed",
            "pruned",
            "budget_exhausted",
            "run_stopped"
          ]
        },
        "direction": {"enum": ["forward", "backward", "join"]},
        "provider_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "label_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "offer_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_status": {"$ref": "#/$defs/evidence_status"},
        "prune_reason": {"$ref": "#/$defs/prune_reason"},
        "detail": {"type": "string"},
        "metrics": {"$ref": "#/$defs/event_metrics"}
      },
      "allOf": [
        {
          "if": {"properties": {"event_type": {"const": "pruned"}}, "required": ["event_type"]},
          "then": {"required": ["prune_reason"]}
        }
      ],
      "additionalProperties": false
    },
    "event_metrics": {
      "type": "object",
      "properties": {
        "cost_lower": {"$ref": "#/$defs/money"},
        "cost_upper": {"$ref": "#/$defs/money"},
        "duration_lower_minutes": {"type": "integer", "minimum": 0},
        "duration_upper_minutes": {"type": "integer", "minimum": 0},
        "frontier_size": {"type": "integer", "minimum": 0},
        "unresolved_gap_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "movement_edge_ids",
        "price_assembly",
        "total_duration_minutes",
        "transfers",
        "evidence_status",
        "pareto_dimensions"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "movement_edge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "price_assembly": {"$ref": "#/$defs/price_assembly"},
        "total_duration_minutes": {"type": "integer", "minimum": 0},
        "transfers": {"type": "integer", "minimum": 0},
        "evidence_status": {"$ref": "#/$defs/evidence_status"},
        "pareto_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["total_cost", "total_duration", "transfers", "evidence_uncertainty"]}
        },
        "dominated": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "mandatory_cost_item": {
      "type": "object",
      "required": ["cost_item_id", "category", "amount", "evidence_id", "cost_relationship"],
      "properties": {
        "cost_item_id": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "origin_ground_cost",
            "intermediate_ground_cost",
            "destination_ground_cost",
            "mandatory_baggage_cost",
            "required_accommodation_cost",
            "other_mandatory_costs"
          ]
        },
        "amount": {"$ref": "#/$defs/money"},
        "evidence_id": {"type": "string", "minLength": 1},
        "cost_relationship": {
          "enum": ["additional_to_atomic_offers", "included_in_atomic_offer"]
        },
        "optimization_treatment": {
          "enum": ["included", "excluded_by_accommodation_cost_policy"],
          "description": "Only required_accommodation_cost may use the excluded treatment."
        },
        "included_in_offer_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"cost_relationship": {"const": "included_in_atomic_offer"}},
            "required": ["cost_relationship"]
          },
          "then": {"required": ["included_in_offer_id"]}
        },
        {
          "if": {
            "properties": {
              "optimization_treatment": {
                "const": "excluded_by_accommodation_cost_policy"
              }
            },
            "required": ["optimization_treatment"]
          },
          "then": {
            "properties": {"category": {"const": "required_accommodation_cost"}},
            "required": ["category"]
          }
        }
      ],
      "additionalProperties": false
    },
    "price_assembly": {
      "type": "object",
      "description": "Build total cost from distinct atomic offers plus mandatory cost items marked additional_to_atomic_offers. Included items remain auditable but are not added twice; never use invented per-movement prices.",
      "required": [
        "atomic_offer_ids",
        "mandatory_cost_items",
        "accommodation_cost_policy",
        "required_accommodation_cost_observed",
        "required_accommodation_cost_included",
        "excluded_required_accommodation_cost",
        "total_trip_cost",
        "segment_price_summing_forbidden"
      ],
      "properties": {
        "atomic_offer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "mandatory_cost_items": {
          "type": "array",
          "items": {"$ref": "#/$defs/mandatory_cost_item"}
        },
        "accommodation_cost_policy": {
          "enum": ["include_required", "exclude_from_optimization"]
        },
        "required_accommodation_cost_observed": {"$ref": "#/$defs/money"},
        "required_accommodation_cost_included": {"$ref": "#/$defs/money"},
        "excluded_required_accommodation_cost": {"$ref": "#/$defs/money"},
        "total_trip_cost": {"$ref": "#/$defs/money"},
        "segment_price_summing_forbidden": {"const": true}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "origin_nodes_considered",
        "destination_nodes_considered",
        "providers_queried",
        "date_buckets_queried",
        "geographic_cells_expanded",
        "unresolved_gaps",
        "scope_statement",
        "global_optimality_claimed"
      ],
      "properties": {
        "origin_nodes_considered": {"type": "integer", "minimum": 0},
        "destination_nodes_considered": {"type": "integer", "minimum": 0},
        "providers_queried": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "date_buckets_queried": {"type": "integer", "minimum": 0},
        "geographic_cells_expanded": {"type": "integer", "minimum": 0},
        "unresolved_gaps": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "scope_statement": {"type": "string", "minLength": 1},
        "global_optimality_claimed": {"const": false}
      },
      "additionalProperties": false
    },
    "termination": {
      "type": "object",
      "required": ["reason", "frontier_changed_last_at", "detail"],
      "properties": {
        "reason": {
          "enum": [
            "frontier_proven_within_observed_graph",
            "all_queued_pairs_infeasible",
            "frontier_stable",
            "provider_budget_exhausted",
            "wall_clock_budget_exhausted",
            "label_budget_exhausted",
            "candidate_budget_exhausted",
            "cancelled",
            "failed"
          ]
        },
        "frontier_changed_last_at": {"type": ["string", "null"], "format": "date-time"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence_status": {
      "enum": ["confirmed", "estimate", "research_candidate", "rejected"]
    },
    "verification_status": {
      "enum": [
        "current_quote",
        "current_schedule",
        "static_topology",
        "stale_quote",
        "reported",
        "inferred",
        "unresolved",
        "rejected"
      ]
    },
    "prune_reason": {
      "enum": [
        "hard_constraint_total_cost",
        "hard_constraint_total_duration",
        "hard_constraint_ground_duration",
        "hard_constraint_wait_duration",
        "hard_constraint_transfer_limit",
        "hard_constraint_self_transfer_limit",
        "hard_constraint_overnight_limit",
        "hard_constraint_border_crossing_limit",
        "hard_constraint_leg_limit",
        "hard_constraint_mode_not_allowed",
        "hard_constraint_date_window",
        "time_incompatible",
        "minimum_connection_not_met",
        "maximum_connection_exceeded",
        "admissible_cost_bound_cannot_improve_incumbent",
        "admissible_bound_dominated_by_frontier",
        "minimum_savings_not_met",
        "temporal_label_dominated",
        "forward_anchor_quota_exceeded",
        "backward_anchor_quota_exceeded",
        "geographic_quota_exceeded",
        "operator_network_quota_exceeded",
        "date_bucket_quota_exceeded",
        "route_shape_quota_exceeded",
        "duplicate_candidate",
        "missing_required_evidence",
        "stale_evidence_refresh_failed",
        "provider_unavailable",
        "negative_cache_hit",
