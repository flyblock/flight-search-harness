{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/schemas/temporal-corridor-policy.schema.json",
  "title": "Temporal corridor scheduler policy v0.7.1",
  "description": "Bounded policy for corridor-specific flexible-date discovery. It schedules evidence research; it does not create travel edges.",
  "type": "object",
  "required": ["schema_version", "policy_id", "query_budget", "date_search", "corridor_discovery", "quotas"],
  "properties": {
    "schema_version": {"const": "0.7.1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "query_budget": {"type": "integer", "minimum": 1},
    "date_search": {
      "type": "object",
      "required": ["calendar_bucket_days", "anchor_window_days_before", "anchor_window_days_after", "max_pareto_dates_per_corridor_direction", "max_exact_dates_per_request", "pareto_dimensions"],
      "properties": {
        "calendar_bucket_days": {"type": "integer", "minimum": 1, "maximum": 31},
        "anchor_window_days_before": {"type": "integer", "minimum": 0, "maximum": 31},
        "anchor_window_days_after": {"type": "integer", "minimum": 0, "maximum": 31},
        "max_pareto_dates_per_corridor_direction": {"type": "integer", "minimum": 1},
        "max_exact_dates_per_request": {"type": "integer", "minimum": 1},
        "pareto_dimensions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["mandatory_total_cost", "elapsed_minutes", "departure_time", "arrival_time"]}
        }
      },
      "additionalProperties": false
    },
    "corridor_discovery": {
      "type": "object",
      "required": ["max_anchor_pairs", "max_days_between_anchors", "include_observed_connector_paths", "unknown_connector_research"],
      "properties": {
        "max_anchor_pairs": {"type": "integer", "minimum": 1},
        "max_days_between_anchors": {"type": "integer", "minimum": 0},
        "include_observed_connector_paths": {"type": "boolean"},
        "unknown_connector_research": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "quotas": {
      "type": "object",
      "required": ["per_corridor", "per_geographic_cell", "per_route_shape", "per_date_bucket", "exploration_reserved", "conventional_baseline_reserved"],
      "properties": {
        "per_corridor": {"type": "integer", "minimum": 1},
        "per_geographic_cell": {"type": "integer", "minimum": 1},
        "per_route_shape": {"type": "integer", "minimum": 1},
        "per_date_bucket": {"type": "integer", "minimum": 1},
        "exploration_reserved": {"type": "integer", "minimum": 0},
        "conventional_baseline_reserved": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
