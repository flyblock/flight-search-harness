{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/product/one-way/schemas/region-node.schema.json",
  "title": "Regional travel node v0.7.1",
  "type": "object",
  "required": ["node_id", "node_type", "location", "country_or_region", "timezone"],
  "properties": {
    "node_id": {"type": "string", "minLength": 1},
    "node_type": {
      "enum": ["airport", "railway_station", "bus_terminal", "ferry_terminal", "city_destination"]
    },
    "location": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "country_or_region": {"type": "string", "minLength": 1},
    "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "timezone": {"type": "string", "minLength": 1},
    "region_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "is_border_crossing_point": {"type": "boolean", "default": false},
    "provider_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider_id", "external_id"],
        "properties": {
          "provider_id": {"type": "string", "minLength": 1},
          "external_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": true
}
