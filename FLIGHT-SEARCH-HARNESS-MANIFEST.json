    "skills/low-cost-random-loop-flight-search/assets/request-template.json",
    "skills/low-cost-random-loop-flight-search/scripts/resolve_harness.py",
    "skills/low-cost-one-way-travel-flight-search/SKILL.md",
    "skills/low-cost-one-way-travel-flight-search/agents/openai.yaml",
    "skills/low-cost-one-way-travel-flight-search/assets/request-template.json",
    "skills/low-cost-one-way-travel-flight-search/scripts/resolve_harness.py",
    "skills/low-cost-round-trip-flight-search/SKILL.md",
