{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/protocol-3/harness-outcome.schema.json",
  "title": "Flight Search Harness Outcome v2",
  "type": "object",
  "required": ["outcome_version", "kind", "run_id", "product_id"],
  "properties": {
    "outcome_version": {"const": "2.0"},
    "kind": {"enum": ["draft", "blocked", "failed", "completed"]},
    "run_id": {"type": ["string", "null"]},
    "product_id": {"type": ["string", "null"]},
    "reason": {"type": "string"},
    "action_required": {},
    "error": {"type": "object"},
    "result_ref": {"const": "product/final.json"},
    "result_summary_ref": {"const": "result/summary.json"},
    "result": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["draft", "blocked"]}}, "required": ["kind"]},
      "then": {"required": ["reason"]}
    },
    {
      "if": {"properties": {"kind": {"const": "failed"}}, "required": ["kind"]},
      "then": {"required": ["error"]}
    },
    {
      "if": {"properties": {"kind": {"const": "completed"}}, "required": ["kind"]},
      "then": {"required": ["result_ref", "result"]}
    }
  ],
  "additionalProperties": false
}
