{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/protocol-3/mission-lease.schema.json",
  "title": "Search Mission Lease v3",
  "type": "object",
  "required": ["lease_version", "lease_id", "run_id", "mission_revision", "items", "claim"],
  "properties": {
    "lease_version": {"const": "3.0"},
    "lease_id": {"type": "string", "pattern": "^lease-[0-9]{6}$"},
    "run_id": {"type": "string", "minLength": 1},
    "mission_revision": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "items": {"$ref": "work-item.schema.json"}},
    "claim": {
      "oneOf": [
        {
          "type": "object",
          "required": ["claim_id", "worker_instance_id", "expires_at"],
          "properties": {
            "claim_id": {"type": "string", "minLength": 1},
            "worker_instance_id": {"type": "string", "minLength": 1},
            "expires_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": false
}
