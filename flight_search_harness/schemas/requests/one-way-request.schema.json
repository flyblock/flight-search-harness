{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-way-request.schema.json",
  "title": "One-way Flight Search Harness request v4",
  "type": "object",
  "required": ["request_version", "journey_shape", "intent"],
  "properties": {
    "request_version": {"const": "4.0"},
    "journey_shape": {"const": "one_way"},
    "intent": {
      "type": "object",
      "required": [
        "base_currency",
        "adult_count",
        "baggage_policy",
        "overnight_allowed",
        "self_transfer_policy",
        "origin",
        "destination",
        "departure_window"
      ],
      "properties": {
        "base_currency": {"$ref": "common-defs.schema.json#/$defs/currency_code"},
        "adult_count": {"type": "integer", "minimum": 1, "description": "Number of adult travelers. Child and infant fares are not supported."},
        "baggage_policy": {
          "allOf": [
            {"$ref": "common-defs.schema.json#/$defs/baggage_policy"},
            {"properties": {"cabin_baggage": {"const": "none_required"}, "checked_bag_count": {"const": 0}, "paid_baggage_allowed": {"const": true}}}
          ],
          "description": "The current one-way Product Kernel supports only no minimum baggage requirement."
        },
        "overnight_allowed": {"type": "boolean", "description": "Whether a connection wait may cross a local calendar day."},
        "self_transfer_policy": {"$ref": "common-defs.schema.json#/$defs/self_transfer_policy"},
        "origin": {
          "allOf": [
            {"$ref": "common-defs.schema.json#/$defs/fixed_region_side"},
            {"properties": {"endpoint_policy": {"const": "anchor_required"}}}
          ]
        },
        "destination": {
          "allOf": [
            {"$ref": "common-defs.schema.json#/$defs/fixed_region_side"},
            {"properties": {"endpoint_policy": {"const": "anchor_required"}}}
          ]
        },
        "departure_window": {"$ref": "common-defs.schema.json#/$defs/date_or_datetime_window"},
        "exact_departure_dates": {"$ref": "common-defs.schema.json#/$defs/exact_departure_dates"},
        "budget": {
          "description": "Optional inclusive hard ceiling for the complete mandatory journey price; null means no ceiling.",
          "oneOf": [
            {"$ref": "common-defs.schema.json#/$defs/money"},
            {"type": "null"}
          ]
        },
        "allowed_modes": {
          "allOf": [
            {"$ref": "common-defs.schema.json#/$defs/allowed_modes"},
            {"contains": {"const": "flight"}}
          ]
        },
        "maximum_total_duration_minutes": {"type": "integer", "minimum": 1, "description": "Inclusive elapsed-time ceiling for the complete one-way journey."}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
