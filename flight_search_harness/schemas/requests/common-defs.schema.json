{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-defs.schema.json",
  "title": "Flight Search Harness public request definitions v4",
  "$defs": {
    "currency_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"$ref": "#/$defs/currency_code"}
      },
      "additionalProperties": false
    },
    "baggage_policy": {
      "type": "object",
      "required": ["cabin_baggage", "checked_bag_count", "paid_baggage_allowed"],
      "properties": {
        "cabin_baggage": {
          "enum": ["none_required", "personal_item", "cabin_bag", "personal_item_and_cabin_bag"],
          "description": "The minimum cabin-baggage entitlement required. none_required does not exclude fares that include baggage."
        },
        "checked_bag_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The total number of checked bags required for the traveler party."
        },
        "paid_baggage_allowed": {
          "type": "boolean",
          "description": "Whether missing required baggage may be purchased when its observed mandatory cost is included in the total."
        }
      },
      "additionalProperties": false
    },
    "date_or_datetime_window": {
      "type": "object",
      "description": "A same-representation window whose end must be strictly later than its start.",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "end": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        }
      },
      "additionalProperties": false
    },
    "offset_datetime_window": {
      "type": "object",
      "description": "An offset-aware window whose end must be strictly later than its start.",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "exact_departure_dates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Optional exact departure dates inside the required departure window. Omission allows the whole window.",
      "items": {"type": "string", "format": "date"}
    },
    "node": {
      "type": "object",
      "required": ["node_id", "node_type", "location", "country_or_region", "country_code", "timezone"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "node_type": {
          "enum": ["airport", "railway_station", "bus_terminal", "ferry_terminal", "city_destination"]
        },
        "location": {"type": "string", "minLength": 1},
        "country_or_region": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "timezone": {"type": "string", "minLength": 1},
        "utc_offset": {"type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$"}
      },
      "additionalProperties": false
    },
    "fixed_region_side": {
      "type": "object",
      "required": [
        "region_id",
        "label",
        "country_codes",
        "policy",
        "endpoint_policy",
        "anchor_nodes",
        "seed_gateway_nodes",
        "max_ground_cost"
      ],
      "properties": {
        "region_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "label": {"type": "string", "minLength": 1},
        "country_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
        },
        "policy": {"enum": ["exact", "city_region", "extended_region"]},
        "endpoint_policy": {"enum": ["anchor_required", "any_admitted_gateway"]},
        "anchor_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node"}
        },
        "seed_gateway_nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        },
        "max_access_time_minutes": {"type": ["integer", "null"], "minimum": 0, "description": "Optional user hard ceiling for regional access time; null or omission means no user ceiling."},
        "max_egress_time_minutes": {"type": ["integer", "null"], "minimum": 0, "description": "Optional user hard ceiling for regional egress time; null or omission means no user ceiling."},
        "max_ground_cost": {
          "description": "Inclusive hard price ceiling for one required regional access or egress Offer; null means no price ceiling.",
          "oneOf": [
            {"$ref": "#/$defs/money"},
            {"type": "null"}
          ]
        },
        "allowed_ground_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]}
        }
      },
      "anyOf": [
        {
          "required": ["anchor_nodes"],
          "properties": {
            "anchor_nodes": {
              "contains": {
                "type": "object",
                "required": ["node_type"],
                "properties": {"node_type": {"const": "airport"}}
              }
            }
          }
        },
        {
          "required": ["seed_gateway_nodes"],
          "properties": {
            "seed_gateway_nodes": {"minItems": 1}
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["policy"],
            "properties": {"policy": {"const": "exact"}}
          },
          "then": {
            "required": ["endpoint_policy"],
            "properties": {"endpoint_policy": {"const": "anchor_required"}}
          }
        }
      ],
      "additionalProperties": false
    },
    "allowed_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Hard allowed-mode set for the complete journey. Must include every effective allowed_ground_modes value from both regional sides.",
      "items": {"enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]}
    },
    "self_transfer_policy": {
      "enum": ["allow", "never"],
      "description": "Whether independently ticketed flight connections are allowed."
    }
  }
}
