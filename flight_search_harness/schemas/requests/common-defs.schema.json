{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-defs.schema.json",
  "title": "Flight Search Harness public request definitions v2",
  "$defs": {
    "currency_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "fx_to_base": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z]{3}$"},
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0},
      "description": "Positive rates into base_currency. The base_currency entry must be 1.0."
    },
    "fx_snapshot": {
      "type": "object",
      "description": "Source-attributed rates satisfying observed_at <= current UTC < expires_at at Run start and again at finalization.",
      "required": ["base_currency", "rates", "source_url", "provider", "observed_at", "expires_at"],
      "properties": {
        "base_currency": {"$ref": "#/$defs/currency_code"},
        "rates": {"$ref": "#/$defs/fx_to_base"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "provider": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"$ref": "#/$defs/currency_code"}
      },
      "additionalProperties": false
    },
    "baggage_policy": {
      "type": "object",
      "required": ["cabin_baggage", "checked_bag_count", "paid_baggage_allowed"],
      "properties": {
        "cabin_baggage": {
          "type": "string",
          "minLength": 1,
          "description": "The explicit cabin-baggage requirement to verify and price."
        },
        "checked_bag_count": {"type": "integer", "minimum": 0},
        "paid_baggage_allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "date_or_datetime_window": {
      "type": "object",
      "description": "A same-representation window whose end must be strictly later than its start.",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "end": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        }
      },
      "additionalProperties": false
    },
    "offset_datetime_window": {
      "type": "object",
      "description": "An offset-aware window whose end must be strictly later than its start.",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "date_flexibility": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["exact_dates", "bounded_window", "fully_flexible"]},
        "exact_departure_dates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "exact_dates"}}, "required": ["mode"]},
          "then": {"required": ["exact_departure_dates"]}
        }
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["node_id", "node_type", "location", "country_or_region", "country_code", "timezone"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "node_type": {
          "enum": ["airport", "railway_station", "bus_terminal", "ferry_terminal", "city_destination"]
        },
        "location": {"type": "string", "minLength": 1},
        "country_or_region": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "timezone": {"type": "string", "minLength": 1},
        "utc_offset": {"type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$"}
      },
      "additionalProperties": false
    },
    "fixed_region_side": {
      "type": "object",
      "required": [
        "region_id",
        "label",
        "country_codes",
        "policy",
        "endpoint_policy",
        "anchor_nodes",
        "seed_gateway_nodes",
        "max_ground_cost"
      ],
      "properties": {
        "region_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "label": {"type": "string", "minLength": 1},
        "country_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
        },
        "policy": {"enum": ["exact", "city_region", "extended_region"]},
        "endpoint_policy": {"enum": ["anchor_required", "any_admitted_gateway"]},
        "anchor_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node"}
        },
        "seed_gateway_nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        },
        "max_access_time_minutes": {"type": "integer", "minimum": 0},
        "max_egress_time_minutes": {"type": "integer", "minimum": 0},
        "max_ground_cost": {
          "oneOf": [
            {"$ref": "#/$defs/money"},
            {"type": "null"}
          ]
        },
        "allowed_ground_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]}
        }
      },
      "anyOf": [
        {
          "required": ["anchor_nodes"],
          "properties": {
            "anchor_nodes": {
              "contains": {
                "type": "object",
                "required": ["node_type"],
                "properties": {"node_type": {"const": "airport"}}
              }
            }
          }
        },
        {
          "required": ["seed_gateway_nodes"],
          "properties": {
            "seed_gateway_nodes": {"minItems": 1}
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["policy"],
            "properties": {"policy": {"const": "exact"}}
          },
          "then": {
            "required": ["endpoint_policy"],
            "properties": {"endpoint_policy": {"const": "anchor_required"}}
          }
        }
      ],
      "additionalProperties": false
    },
    "allowed_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Must include every effective allowed_ground_modes value from both regional sides, including Product Kernel defaults when a side omits that field.",
      "items": {"enum": ["flight", "rail", "bus", "coach", "ferry", "local_transit", "walk", "rideshare", "car"]}
    },
    "self_transfer_policy": {"enum": ["allow", "avoid", "never"]}
  }
}
