{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/protocol-3/result-summary.schema.json",
  "title": "Regenerable travel result summary v1",
  "type": "object",
  "required": ["summary_version", "product_id", "search_status", "incomplete", "full_result_ref", "result_kind"],
  "properties": {
    "summary_version": {"const": "1.0"},
    "product_id": {"type": "string"},
    "search_status": {"type": "string"},
    "incomplete": {"type": "boolean"},
    "outcome": {"type": ["string", "null"]},
    "full_result_ref": {"const": "product/final.json"},
    "result_kind": {"enum": ["random_loop_route", "random_loop_no_result", "one_way_route", "round_trip_portfolio"]}
  },
  "additionalProperties": true
}
