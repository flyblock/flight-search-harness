{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-request.schema.json",
  "title": "Flight search request version 7",
  "description": "Small user request contract. normalize_request additionally checks ordering, same-currency limits, finite numbers, and unique requirement IDs. It accepts version 6 without silently carrying research-credit policy forward. Departure windows never imply arrival windows.",
  "type": "object",
  "required": [
    "request_version",
    "journey_shape",
    "intent"
  ],
  "properties": {
    "request_version": {
      "const": "7.0"
    },
    "journey_shape": {
      "enum": [
        "round_trip",
        "one_way",
        "random_loop"
      ]
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "journey_shape": {
          "const": "round_trip"
        },
        "intent": {
          "type": "object",
          "properties": {
            "additional_requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "requirement_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "requirement_id",
                  "text"
                ],
                "additionalProperties": false
              },
              "description": "User conditions requiring evidence-based AI assessment. Text is not an executable expression. IDs must be unique."
            },
            "adult_count": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Adult travelers. Agents should make traveler count explicit rather than infer a party size from unrelated context."
            },
            "airport_transit_unknown_policy": {
              "enum": [
                "allow_with_warning",
                "reject"
              ],
              "description": "Unknown transit feasibility may remain an explicitly unverified candidate or be rejected; it is never confirmed transit eligibility."
            },
            "allowed_modes": {
              "$ref": "#/$defs/allowed_modes"
            },
            "baggage_policy": {
              "$ref": "#/$defs/baggage_policy"
            },
            "base_currency": {
              "$ref": "#/$defs/currency_code"
            },
            "budget": {
              "oneOf": [
                {
                  "$ref": "#/$defs/money"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive hard budget in base_currency for the requested ranking_basis."
            },
            "destination": {
              "$ref": "#/$defs/fixed_region_side"
            },
            "destination_airports": {
              "$ref": "#/$defs/airport_pool"
            },
            "fx_rates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from_currency": {
                    "$ref": "#/$defs/currency_code"
                  },
                  "to_currency": {
                    "$ref": "#/$defs/currency_code"
                  },
                  "rate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "observed_at": {
                    "$ref": "#/$defs/offset_timestamp"
                  },
                  "source_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Optional full reference, retained without link syntax or length gating."
                  },
                  "source_name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Observed rate source name; usable attribution even when its URL is unavailable."
                  }
                },
                "required": [
                  "from_currency",
                  "to_currency",
                  "rate",
                  "observed_at"
                ],
                "additionalProperties": false
              }
            },
            "maximum_outbound_duration_minutes": {
              "type": "integer",
              "minimum": 1,
              "description": "Inclusive elapsed-time ceiling for the complete outbound journey."
            },
            "maximum_return_duration_minutes": {
              "type": "integer",
              "minimum": 1,
              "description": "Inclusive elapsed-time ceiling for the complete return journey."
            },
            "maximum_stay_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_stay_nights": {
              "type": "integer",
              "minimum": 0,
              "description": "Maximum difference between the destination-local arrival date and first return-departure date."
            },
            "maximum_total_duration_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_transfer_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional explicit hard transfer-count ceiling. Omission leaves transfer count unbounded by product policy."
            },
            "minimum_stay_nights": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum difference between the destination-local arrival date and first return-departure date."
            },
            "objective": {
              "enum": [
                "price",
                "travel_duration",
                "distance_per_currency",
                "stay_duration"
              ],
              "description": "Defaults to price, or distance_per_currency for random_loop."
            },
            "origin": {
              "$ref": "#/$defs/fixed_region_side"
            },
            "origin_airports": {
              "$ref": "#/$defs/airport_pool"
            },
            "outbound_departure_window": {
              "$ref": "#/$defs/date_or_datetime_window",
              "description": "Date-only boundaries use the origin Anchor IANA timezone."
            },
            "outbound_exact_departure_dates": {
              "$ref": "#/$defs/exact_departure_dates"
            },
            "output": {
              "type": "object",
              "properties": {
                "view": {
                  "enum": [
                    "ranked",
                    "matrix"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "view"
              ],
              "additionalProperties": false,
              "description": "Output selection only; does not limit retained discoveries."
            },
            "overnight_allowed": {
              "type": "boolean"
            },
            "presence_intervals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "$ref": "#/$defs/offset_timestamp"
                  },
                  "end": {
                    "$ref": "#/$defs/offset_timestamp"
                  },
                  "location_node_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "start",
                  "end",
                  "location_node_id"
                ],
                "additionalProperties": false
              }
            },
            "price_target": {
              "oneOf": [
                {
                  "$ref": "#/$defs/money"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Soft price preference in base_currency; does not exclude more expensive alternatives."
            },
            "ranking_basis": {
              "enum": [
                "mandatory_air_ticket_total",
                "complete_journey_cost"
              ],
              "default": "mandatory_air_ticket_total",
              "description": "Ticket comparison is the default; complete journey costs are calculated only when requested."
            },
            "return_arrival_window": {
              "$ref": "#/$defs/date_or_datetime_window"
            },
            "return_departure_window": {
              "$ref": "#/$defs/date_or_datetime_window",
              "description": "Date-only boundaries use the destination Anchor IANA timezone."
            },
            "return_exact_departure_dates": {
              "$ref": "#/$defs/exact_departure_dates"
            },
            "search_limits": {
              "type": "object",
              "properties": {
                "max_queries": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_elapsed_minutes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [],
              "additionalProperties": false,
              "description": "Only explicit limits apply. No research-credit defaults or implicit limit conversions."
            },
            "self_transfer_policy": {
              "enum": [
                "allow",
                "never"
              ]
            },
            "travel_windows": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "outbound_departure_window",
                  "return_departure_window"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outbound_departure_window": {
                    "$ref": "#/$defs/date_or_datetime_window"
                  },
                  "return_departure_window": {
                    "$ref": "#/$defs/date_or_datetime_window"
                  },
                  "minimum_stay_nights": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maximum_stay_nights": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "description": "Disjoint round-trip date alternatives inside one Search Mission."
            }
          },
          "required": [
            "base_currency"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "origin"
                  ]
                },
                {
                  "required": [
                    "origin_airports"
                  ]
                }
              ]
            },
            {
              "oneOf": [
                {
                  "required": [
                    "destination"
                  ]
                },
                {
                  "required": [
                    "destination_airports"
                  ]
                }
              ]
            },
            {
              "oneOf": [
                {
                  "required": [
                    "outbound_departure_window"
                  ],
                  "not": {
                    "required": [
                      "travel_windows"
                    ]
                  }
                },
                {
                  "required": [
                    "travel_windows"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "outbound_departure_window"
                        ]
                      },
                      {
                        "required": [
                          "return_departure_window"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "properties": {
        "journey_shape": {
          "const": "one_way"
        },
        "intent": {
          "type": "object",
          "properties": {
            "additional_requirements": {
              "type": "array",
              "items": {
