              "type": "integer",
              "minimum": 1
            },
            "maximum_total_duration_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "min_legs": {
              "type": "integer",
              "minimum": 1
            },
            "objective": {
              "enum": [
