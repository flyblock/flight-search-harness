{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/protocol-3/run-manifest.schema.json",
  "title": "Flight Search Harness Run v3",
  "type": "object",
  "required": ["run_version", "harness_version", "run_id", "product_id", "journey_shape", "status", "request", "created_at", "updated_at", "last_outcome", "mission_ref", "product_session_ref"],
  "properties": {
    "run_version": {"const": "3.0"},
    "harness_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"},
    "product_id": {"type": "string", "minLength": 1},
    "journey_shape": {"enum": ["random_loop", "one_way", "round_trip"]},
    "status": {"enum": ["initializing", "running", "draft", "blocked", "failed", "completed"]},
    "request": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "last_outcome": {"type": ["object", "null"]},
    "mission_ref": {"const": "mission/mission.json"},
    "product_session_ref": {"const": "product/session.json"},
    "result_ref": {"const": "product/final.json"}
  },
  "additionalProperties": false
}
