{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/protocol-3/harness-event.schema.json",
  "title": "Flight Search Harness append-only event v1",
  "type": "object",
  "required": ["event_version", "sequence", "type", "at"],
  "properties": {
    "event_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "minLength": 1},
    "at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
