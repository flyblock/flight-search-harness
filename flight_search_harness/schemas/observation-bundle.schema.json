{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation-bundle.schema.json",
  "title": "Shared raw Observation bundle v1",
  "type": "object",
  "required": ["kind", "bundle_id", "source", "observations"],
  "properties": {
    "kind": {"const": "observation_bundle"},
    "bundle_id": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "coverage_complete": {"type": "boolean"},
    "discovered_nodes": {"type": "array"},
    "observations": {"type": "array", "minItems": 1},
    "product_payload": {"type": "object"}
  },
  "additionalProperties": false
}
