{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/protocol-3/mission-receipt-batch.schema.json",
  "title": "Search Mission Receipt batch v2",
  "type": "object",
  "required": ["lease_id", "mission_revision", "claim_id", "worker_instance_id", "receipts"],
  "properties": {
    "lease_id": {"type": "string", "minLength": 1},
    "mission_revision": {"type": "integer", "minimum": 0},
    "claim_id": {"type": "string", "minLength": 1},
    "worker_instance_id": {"type": "string", "minLength": 1},
    "receipts": {"type": "array", "minItems": 1, "items": {"$ref": "mission-receipt.schema.json"}},
    "metrics": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
