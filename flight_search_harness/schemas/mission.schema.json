{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/protocol-3/mission.schema.json",
  "title": "Search Mission execution cursor v3",
  "type": "object",
  "required": ["mission_version", "run_id", "revision", "next_lease_sequence", "active_lease_ref", "work_items"],
  "properties": {
    "mission_version": {"const": "3.0"},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "next_lease_sequence": {"type": "integer", "minimum": 1},
    "active_lease_ref": {
      "oneOf": [
        {"type": "string", "pattern": "^mission/leases/lease-[0-9]{6}\\.json$"},
        {"type": "null"}
      ]
    },
    "work_items": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/work_index"}
    }
  },
  "$defs": {
    "work_index": {
      "type": "object",
      "required": ["item_ref", "item_hash", "attempt_count"],
      "properties": {
        "item_ref": {"type": "string"},
        "item_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attempt_count": {"type": "integer", "minimum": 1},
        "last_error": {"type": "string"},
        "last_decision": {"enum": ["committed", "retry_required", "blocked"]},
        "last_decision_attempt": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
