{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flight-search-harness/cost-scope.schema.json",
  "title": "Flight Search Harness Cost Scope Summary v1",
  "type": "object",
  "required": [
    "cost_scope_version",
    "journey_shape",
    "base_currency",
    "origin_endpoint_policy",
    "destination_endpoint_policy",
    "completion_scope",
    "gateway_complete_cost",
    "endpoint_roles",
    "endpoint_completion_status",
    "endpoint_completion_cost",
    "anchor_complete_cost",
    "comparison_total"
  ],
  "properties": {
    "cost_scope_version": {"const": "1.0"},
    "journey_shape": {"enum": ["one_way", "round_trip"]},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "origin_endpoint_policy": {"$ref": "#/$defs/endpoint_policy"},
    "destination_endpoint_policy": {"$ref": "#/$defs/endpoint_policy"},
    "completion_scope": {
      "enum": [
        "anchor_to_anchor",
        "origin_anchor_to_destination_gateway",
        "origin_gateway_to_destination_anchor",
        "gateway_to_gateway"
      ]
    },
    "gateway_complete_cost": {"$ref": "#/$defs/money"},
    "endpoint_roles": {
      "type": "object",
      "required": [
        "origin_access",
        "origin_egress",
        "destination_access",
        "destination_egress"
      ],
      "properties": {
        "origin_access": {"$ref": "#/$defs/endpoint_role"},
        "origin_egress": {"$ref": "#/$defs/endpoint_role"},
        "destination_access": {"$ref": "#/$defs/endpoint_role"},
        "destination_egress": {"$ref": "#/$defs/endpoint_role"}
      },
      "additionalProperties": false
    },
    "endpoint_completion_status": {"enum": ["complete", "incomplete"]},
    "endpoint_completion_cost": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
    "anchor_complete_cost": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
    "comparison_total": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}
  },
  "additionalProperties": false,
  "$defs": {
    "endpoint_policy": {"enum": ["anchor_required", "any_admitted_gateway"]},
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "additionalProperties": false
    },
    "endpoint_role": {
      "type": "object",
      "required": ["status", "cost"],
      "properties": {
        "status": {"enum": ["verified", "missing", "not_required", "not_applicable"]},
        "cost": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
